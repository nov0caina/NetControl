[Desktop Entry]
Version=1.0
Type=Application
Name=SelfishNet
GenericName=Network Traffic Manager
Comment=ARP engine, network traffic monitor, and bandwidth controller
Icon=selfishnet
Exec=sh -c "pkexec env DISPLAY=\$DISPLAY XAUTHORITY=\$XAUTHORITY /usr/local/bin/SelfishNet"
Terminal=false
Categories=Network;Security;
Keywords=network;arp;traffic;bandwidth;monitor;
StartupNotify=true
